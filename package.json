{
  "name": "carejournal",
  "private": true,
  "version": "0.19.21",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve:web": "npm run build && node server/index.mjs",
    "serve:proxy": "node server/index.mjs --proxy-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "android:sync": "npm run build && cap sync android",
    "android:release": "pwsh -NoProfile -File scripts/build-android-release.ps1",
    "ios:sync": "npm run build && cap sync ios",
    "ios:verify": "node scripts/verify-ios-project.mjs",
    "harmony:sync": "node scripts/build-harmony-web.mjs && node scripts/sync-harmony-assets.mjs",
    "harmony:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-harmony.ps1",
    "release": "pwsh -NoProfile -File scripts/publish-release.ps1",
    "tauri": "tauri",
    "tauri:build": "tauri build --no-bundle",
    "tauri:build:portable": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-tauri-portable.ps1"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/ios": "^7.4.3",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@tauri-apps/api": "^2.2.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@tauri-apps/cli": "^2.2.7",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
